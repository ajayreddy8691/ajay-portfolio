# Copy to .env (git-ignored). The app refuses to start without ADMIN_KEY.
ADMIN_KEY=change-this-to-a-long-random-key

# Default is a local SQLite file (zero setup). For MySQL use:
# DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/ajay_portfolio?charset=utf8mb4
DATABASE_URL=sqlite:///./data/portfolio.db

# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Optional owner email notifications (Resend HTTP API; works on free hosts that block SMTP)
# RESEND_API_KEY=re_...
# NOTIFY_EMAIL=ajayreddy8691@gmail.com
# NOTIFY_FROM=Portfolio <onboarding@resend.dev>
# SITE_URL=https://your-site.vercel.app
